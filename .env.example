# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3000
BUSINESS_CONFIG=agent/config.example.yaml

# --- Voice platform auth (set the one you use) ---
# Vapi: the same value you put in the tool's server "secret" / X-Vapi-Secret header
VAPI_SECRET=
# Retell: your API key — used to verify X-Retell-Signature
RETELL_API_KEY=

# --- Calendar ---
# mock (default, writes data/mock-calendar.json) | google
CALENDAR_BACKEND=mock
GOOGLE_CALENDAR_ID=
# Path to the service account JSON key, kept OUTSIDE the repo
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# --- Owner notifications (console is always on) ---
# Any JSON webhook: Slack incoming webhook, Discord, Make, n8n…
NOTIFY_WEBHOOK_URL=
# WhatsApp via Twilio (sandbox works for testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OWNER_WHATSAPP_TO=
